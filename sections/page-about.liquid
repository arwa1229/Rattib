<section style="padding:60px 16px; max-width:680px; margin:0 auto;">
  <h1 style="font-family:'Tajawal',sans-serif;font-weight:900;font-size:30px;color:#262B2B;margin-bottom:24px;text-align:center;">من نحن</h1>

  <div style="background:#DDF3F1;border-radius:16px;padding:32px;margin-bottom:32px;text-align:center;">
    <p style="font-family:'Tajawal',sans-serif;font-weight:700;font-size:20px;color:#2E8F8A;margin-bottom:8px;">بيتك مرتب… حياتك أسهل</p>
    <p style="font-family:'IBM Plex Sans Arabic',sans-serif;font-size:15px;color:#262B2B;line-height:1.8;">رتّب متجر متخصص في منتجات التنظيم المنزلي، نهدف إلى مساعدة كل بيت سعودي على تحقيق مساحة مرتبة وجميلة بأسعار مناسبة.</p>
  </div>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:32px;">
    <div style="background:#F4F6F6;border-radius:14px;padding:24px;text-align:center;">
      <div style="font-size:36px;margin-bottom:10px;">🍳</div>
      <p style="font-family:'Tajawal',sans-serif;font-weight:700;font-size:14px;color:#262B2B;">تنظيم المطبخ</p>
    </div>
    <div style="background:#F4F6F6;border-radius:14px;padding:24px;text-align:center;">
      <div style="font-size:36px;margin-bottom:10px;">🧊</div>
      <p style="font-family:'Tajawal',sans-serif;font-weight:700;font-size:14px;color:#262B2B;">تنظيم الثلاجة</p>
    </div>
    <div style="background:#F4F6F6;border-radius:14px;padding:24px;text-align:center;">
      <div style="font-size:36px;margin-bottom:10px;">🛁</div>
      <p style="font-family:'Tajawal',sans-serif;font-weight:700;font-size:14px;color:#262B2B;">تنظيم الحمام</p>
    </div>
    <div style="background:#F4F6F6;border-radius:14px;padding:24px;text-align:center;">
      <div style="font-size:36px;margin-bottom:10px;">🗄️</div>
      <p style="font-family:'Tajawal',sans-serif;font-weight:700;font-size:14px;color:#262B2B;">تنظيم الأدراج والخزائن</p>
    </div>
    <div style="background:#F4F6F6;border-radius:14px;padding:24px;text-align:center;">
      <div style="font-size:36px;margin-bottom:10px;">🧺</div>
      <p style="font-family:'Tajawal',sans-serif;font-weight:700;font-size:14px;color:#262B2B;">غرفة الغسيل</p>
    </div>
    <div style="background:#F4F6F6;border-radius:14px;padding:24px;text-align:center;">
      <div style="font-size:36px;margin-bottom:10px;">🧸</div>
      <p style="font-family:'Tajawal',sans-serif;font-weight:700;font-size:14px;color:#262B2B;">غرف الأطفال</p>
    </div>
  </div>

  <div style="font-family:'IBM Plex Sans Arabic',sans-serif;font-size:15px;color:#262B2B;line-height:1.9;margin-bottom:32px;">
    {{ page.content }}
  </div>

  <div style="background:#DDF3F1;border-radius:16px;padding:32px;text-align:center;">
    <p style="font-family:'Tajawal',sans-serif;font-weight:900;font-size:20px;color:#2E8F8A;margin-bottom:14px;">وعدنا لك</p>
    <p style="font-family:'IBM Plex Sans Arabic',sans-serif;font-size:15px;color:#262B2B;line-height:1.9;margin-bottom:16px;">نوصلك المنتج اللي طلبتيه بالجودة اللي تستحقينها. وإذا صار أي شيء، فريقنا موجود — تواصلي معنا وبنحل لك الموضوع.</p>
    <p style="font-family:'Tajawal',sans-serif;font-weight:700;font-size:17px;color:#262B2B;">رتّبي بيتك… وخلي الباقي علينا ✨</p>
  </div>
</section>
{% schema %}{ "name": "صفحة من نحن" }{% endschema %}
