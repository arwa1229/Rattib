{%- liquid
  assign threshold = section.settings.threshold | default: settings.free_shipping_threshold | default: 199
  assign threshold_cents = threshold | times: 100
  assign cart_total = cart.total_price | default: 0
  assign remaining_cents = threshold_cents | minus: cart_total
  assign remaining_riyals = remaining_cents | divided_by: 100.0

  if cart_total >= threshold_cents
    assign progress = 100
    assign reached = true
  else
    assign progress = cart_total | times: 100 | divided_by: threshold_cents
    assign reached = false
  endif

  assign bar_text = section.settings.bar_text | default: 'شحن مجاني على الطلبات فوق ١٩٩ ر.س'
  assign reached_text = section.settings.reached_text | default: 'تهانينا! حصلتِ على شحن مجاني 🎉'
-%}

{%- if section.settings.enabled -%}
<div
  class="free-shipping-bar"
  id="section-{{ section.id }}"
  role="status"
  aria-live="polite"
  aria-label="{{ 'cart.free_shipping_progress' | t | default: 'تقدم الشحن المجاني' }}"
>
  <p class="free-shipping-bar__text">
    {%- if reached -%}
      {{ reached_text }}
    {%- elsif cart_total == 0 -%}
      🚚 {{ bar_text }}
    {%- else -%}
      {%- assign remaining_formatted = remaining_riyals | round -%}
      🚚 تحتاجين <strong>{{ remaining_formatted }} ر.س</strong> للحصول على شحن مجاني
    {%- endif -%}
  </p>

  {%- if section.settings.show_progress_bar -%}
    <div class="free-shipping-bar__track" role="progressbar" aria-valuenow="{{ progress }}" aria-valuemin="0" aria-valuemax="100">
      <div
        class="free-shipping-bar__fill"
        style="width: {{ progress }}%;"
      ></div>
    </div>
  {%- endif -%}

</div><!-- /.free-shipping-bar -->
{%- endif -%}

{% schema %}
{
  "name": "Free Shipping Bar — شريط الشحن المجاني",
  "tag": "div",
  "class": "section-free-shipping-bar",
  "limit": 1,
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "تفعيل شريط الشحن المجاني",
      "default": true
    },
    {
      "type": "number",
      "id": "threshold",
      "label": "حد الشحن المجاني (ر.س)",
      "default": 199
    },
    {
      "type": "text",
      "id": "bar_text",
      "label": "نص شريط الشحن",
      "default": "شحن مجاني على الطلبات فوق ١٩٩ ر.س"
    },
    {
      "type": "text",
      "id": "reached_text",
      "label": "النص عند الوصول للحد",
      "default": "تهانينا! حصلتِ على شحن مجاني 🎉"
    },
    {
      "type": "checkbox",
      "id": "show_progress_bar",
      "label": "إظهار شريط التقدم",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Free Shipping Bar — شريط الشحن المجاني",
      "settings": {
        "enabled": true,
        "threshold": 199,
        "show_progress_bar": true
      }
    }
  ]
}
{% endschema %}
