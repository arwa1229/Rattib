<section style="padding:60px 16px; max-width:680px; margin:0 auto;">
  <h1 style="font-family:'Tajawal',sans-serif;font-weight:900;font-size:28px;color:#262B2B;margin-bottom:6px;">{{ page.title }}</h1>
  <p style="font-family:'IBM Plex Sans Arabic',sans-serif;font-size:12px;color:#8A9695;margin-bottom:36px;">آخر تحديث: {{ page.published_at | date: '%d/%m/%Y' }}</p>
  <div style="font-family:'IBM Plex Sans Arabic',sans-serif;font-size:15px;color:#262B2B;line-height:1.9;">
    {{ page.content }}
  </div>
</section>
{% schema %}{ "name": "صفحة سياسة" }{% endschema %}
