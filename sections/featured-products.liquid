{%- liquid
  assign section_heading = section.settings.heading | default: 'منتجات مختارة لكِ'
  assign collection_handle = section.settings.collection_handle | default: 'all'
  assign products_to_show = section.settings.products_to_show | default: 8
  assign show_more_label = section.settings.show_more_label | default: 'عرضي المزيد'
  assign show_more_url = section.settings.show_more_url | default: '/collections/all'
  assign collection = collections[collection_handle]
-%}

<section
  class="section featured-products"
  id="section-{{ section.id }}"
  style="background: {{ section.settings.bg_color | default: '#FFFFFF' }};"
>
  <div class="container">

    <!-- Section Header -->
    <div class="flex-between" style="margin-bottom: 20px;">
      {%- if section_heading != blank -%}
        <h2 class="section-heading" style="margin-bottom:0;">{{ section_heading }}</h2>
      {%- endif -%}
      {%- if section.settings.show_view_all -%}
        <a href="{{ show_more_url }}" class="featured-products__more-link" aria-label="{{ show_more_label }}">
          {{ show_more_label }} ←
        </a>
      {%- endif -%}
    </div>

    <!-- Products Grid -->
    {%- if collection != blank and collection.products_count > 0 -%}
      <div class="featured-products__grid">
        {%- for product in collection.products limit: products_to_show -%}
          {%- liquid
            assign is_bestseller = false
            if product.tags contains 'bestseller'
              assign is_bestseller = true
            endif
          -%}
          {%- render 'product-card',
            product: product,
            show_badges: true,
            show_delivery: false,
            badge_bestseller: is_bestseller
          -%}
        {%- endfor -%}
      </div><!-- /.featured-products__grid -->

    {%- elsif collection == blank or collection.products_count == 0 -%}
      <!-- Placeholder cards when no collection is set -->
      <div class="featured-products__grid">
        {%- for i in (1..4) -%}
          {%- assign placeholder_names = 'product-1,product-2,product-3,product-4' | split: ',' -%}
          <article class="product-card">
            <div class="product-card__image-wrap">
              {{ placeholder_names[forloop.index0] | placeholder_svg_tag: 'product-card__img' }}
            </div>
            <div class="product-card__body">
              <div class="badge-row">
                <span class="badge badge-available">متوفر ✓</span>
                <span class="badge badge-shipping">شحن مجاني</span>
              </div>
              <span class="product-card__title">منتج تنظيم منزلي رائع</span>
              <div class="product-card__price-row">
                <span class="product-card__price">٩٩ ر.س</span>
                <span class="product-card__compare-price">١٢٩ ر.س</span>
              </div>
              <div class="product-card__action">
                <button class="btn btn-primary product-card__btn" disabled>أضف إلى السلة</button>
              </div>
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <!-- Footer: Show More -->
    {%- unless section.settings.show_view_all -%}
      {%- if show_more_label != blank -%}
        <div class="featured-products__footer">
          <a href="{{ show_more_url }}" class="featured-products__more-link">
            {{ show_more_label }} ←
          </a>
        </div>
      {%- endif -%}
    {%- endunless -%}

  </div><!-- /.container -->
</section>

<style>
  #section-{{ section.id }} .featured-products__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  @media (min-width: 680px) {
    #section-{{ section.id }} .featured-products__grid {
      grid-template-columns: repeat(3, 1fr) !important;
      gap: 20px;
    }
  }
</style>

{% schema %}
{
  "name": "Featured Products — منتجات مميزة",
  "tag": "section",
  "class": "section-featured-products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "عنوان القسم",
      "default": "منتجات مختارة لكِ"
    },
    {
      "type": "collection",
      "id": "collection_handle",
      "label": "المجموعة"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "عدد المنتجات للعرض",
      "min": 2,
      "max": 16,
      "step": 2,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "عدد الأعمدة (ديسكتوب)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "لون الخلفية",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "رابط «عرضي المزيد»"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "إظهار رابط «عرضي المزيد» بجانب العنوان",
      "default": true
    },
    {
      "type": "text",
      "id": "show_more_label",
      "label": "نص رابط المزيد",
      "default": "عرضي المزيد"
    },
    {
      "type": "url",
      "id": "show_more_url",
      "label": "رابط المزيد"
    }
  ],
  "presets": [
    {
      "name": "Featured Products — منتجات مميزة",
      "settings": {
        "heading": "منتجات مختارة لكِ",
        "products_to_show": 8,
        "columns_desktop": 4
      }
    }
  ]
}
{% endschema %}
