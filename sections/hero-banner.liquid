<section class="hero-banner" style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;">
  <div class="container">
    <p class="hero-banner__tagline">{{ section.settings.eyebrow }}</p>
    <h1 class="hero-banner__heading">{{ section.settings.heading }}</h1>
    <div class="hero-banner__actions">
      <a href="{{ section.settings.primary_btn_url }}" class="btn btn-primary">
        {{ section.settings.primary_btn_label }}
      </a>
      <a href="{{ section.settings.secondary_btn_url }}" class="btn btn-dark">
        {{ section.settings.secondary_btn_label }}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "البانر الرئيسي",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "النص العلوي", "default": "متجر التنظيم المنزلي" },
    { "type": "text", "id": "heading", "label": "العنوان الرئيسي", "default": "بيتك مرتب… حياتك أسهل" },
    { "type": "text", "id": "primary_btn_label", "label": "نص الزر الأول", "default": "تسوّقي الآن" },
    { "type": "url",  "id": "primary_btn_url",   "label": "رابط الزر الأول" },
    { "type": "text", "id": "secondary_btn_label","label": "نص الزر الثاني", "default": "تصفّحي الفئات" },
    { "type": "url",  "id": "secondary_btn_url",  "label": "رابط الزر الثاني" },
    { "type": "range","id": "padding_top",    "min": 24, "max": 80, "step": 4, "default": 48, "label": "مسافة علوية" },
    { "type": "range","id": "padding_bottom", "min": 24, "max": 80, "step": 4, "default": 40, "label": "مسافة سفلية" }
  ],
  "presets": [{ "name": "البانر الرئيسي" }]
}
{% endschema %}
