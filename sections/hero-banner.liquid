{%- liquid
  assign heading = section.settings.heading | default: 'بيتك مرتب… حياتك أسهل'
  assign subheading = section.settings.subheading | default: 'اكتشفي أجمل حلول التنظيم المنزلي المصممة خصيصًا لكِ — لأن بيتك المرتّب يبدأ من هنا.'
  assign primary_label = section.settings.primary_button_label | default: 'رتّبي بيتك'
  assign primary_url = section.settings.primary_button_url | default: '/collections/all'
  assign secondary_label = section.settings.secondary_button_label | default: 'تسوّقي الآن'
  assign secondary_url = section.settings.secondary_button_url | default: '/collections'
  assign show_delivery = section.settings.show_delivery_badge
  assign delivery_text = section.settings.delivery_badge_text | default: 'يصلكِ خلال ٧–١٢ يوم'
-%}

<section
  class="hero-banner"
  id="section-{{ section.id }}"
  style="
    {%- if section.settings.bg_color != blank -%}background: {{ section.settings.bg_color }};{%- endif -%}
    {%- if section.settings.text_align != blank -%}text-align: {{ section.settings.text_align }};{%- endif -%}
  "
>
  <div class="container">
    <div class="hero-banner__inner">

      <!-- Pre-title label -->
      {%- if section.settings.pretitle != blank -%}
        <p class="hero-banner__pretitle">
          <span aria-hidden="true">✨</span>
          {{ section.settings.pretitle }}
        </p>
      {%- endif -%}

      <!-- Main heading H1 -->
      <h1 class="hero-banner__title">
        {%- assign words = heading | split: '…' -%}
        {%- if words.size > 1 -%}
          {{ words[0] }}…<span>{{ words[1] }}</span>
        {%- else -%}
          {{ heading }}
        {%- endif -%}
      </h1>

      <!-- Subheading -->
      {%- if subheading != blank -%}
        <p class="hero-banner__subtitle">{{ subheading }}</p>
      {%- endif -%}

      <!-- CTA Button -->
      <div class="hero-banner__actions">
        <a href="/collections/all" class="btn btn-primary btn-lg">تسوّقي الآن</a>
      </div>

      <!-- Delivery Badge -->
      {%- if show_delivery -%}
        <div class="hero-banner__badge">
          {%- render 'badge', badge_type: 'delivery', badge_text: delivery_text -%}
        </div>
      {%- endif -%}

      <!-- Hero Image -->
      {%- if section.settings.image != blank -%}
        <div class="hero-banner__image">
          {{
            section.settings.image
            | image_url: width: 680
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '375, 560, 680, 960',
              sizes: '(min-width: 768px) 680px, 100vw',
              alt: heading
          }}
        </div>
      {%- elsif section.settings.show_placeholder_image -%}
        <div class="hero-banner__image">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'hero-placeholder-img' }}
        </div>
      {%- endif -%}

    </div><!-- /.hero-banner__inner -->
  </div><!-- /.container -->
</section>

{% schema %}
{
  "name": "Hero Banner — البانر الرئيسي",
  "tag": "section",
  "class": "section-hero-banner",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "المحتوى"
    },
    {
      "type": "text",
      "id": "pretitle",
      "label": "النص التمهيدي (فوق العنوان)",
      "default": "حلول التنظيم المنزلي"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "العنوان الرئيسي H1",
      "default": "بيتك مرتب… حياتك أسهل"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "النص الفرعي",
      "default": "اكتشفي أجمل حلول التنظيم المنزلي المصممة خصيصًا لكِ — لأن بيتك المرتّب يبدأ من هنا."
    },
    {
      "type": "header",
      "content": "أزرار الاتصال بالإجراء (CTA)"
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "نص الزر الأول",
      "default": "رتّبي بيتك"
    },
    {
      "type": "url",
      "id": "primary_button_url",
      "label": "رابط الزر الأول"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "نص الزر الثاني",
      "default": "تسوّقي الآن"
    },
    {
      "type": "url",
      "id": "secondary_button_url",
      "label": "رابط الزر الثاني"
    },
    {
      "type": "header",
      "content": "شارة التوصيل"
    },
    {
      "type": "checkbox",
      "id": "show_delivery_badge",
      "label": "إظهار شارة موعد التوصيل",
      "default": true
    },
    {
      "type": "text",
      "id": "delivery_badge_text",
      "label": "نص شارة التوصيل",
      "default": "يصلكِ خلال ٧–١٢ يوم"
    },
    {
      "type": "header",
      "content": "الصورة"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "صورة البانر"
    },
    {
      "type": "checkbox",
      "id": "show_placeholder_image",
      "label": "إظهار صورة افتراضية إذا لم تُحدَّد صورة",
      "default": false
    },
    {
      "type": "header",
      "content": "التصميم"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "لون الخلفية (اختياري)"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "محاذاة النص",
      "options": [
        { "value": "right", "label": "يمين" },
        { "value": "center", "label": "وسط" },
        { "value": "left", "label": "يسار" }
      ],
      "default": "center"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner — البانر الرئيسي",
      "settings": {
        "heading": "بيتك مرتب… حياتك أسهل",
        "primary_button_label": "رتّبي بيتك",
        "secondary_button_label": "تسوّقي الآن",
        "show_delivery_badge": true
      }
    }
  ]
}
{% endschema %}
