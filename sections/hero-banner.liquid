{%- liquid
  assign heading = section.settings.heading | default: 'بيتك مرتب… حياتك أسهل'
  assign subheading = section.settings.subheading | default: 'اكتشفي أجمل حلول التنظيم المنزلي المصممة خصيصًا لكِ — لأن بيتك المرتّب يبدأ من هنا.'
  assign show_delivery = section.settings.show_delivery_badge
  assign delivery_text = section.settings.delivery_badge_text | default: 'يصلكِ خلال ٧–١٢ يوم'
-%}

<section
  class="hero-banner"
  id="section-{{ section.id }}"
  style="{%- if section.settings.bg_color != blank -%}background: {{ section.settings.bg_color }};{%- endif -%}"
>
  <div class="container">
    <div class="hero-banner__inner">

      {%- if section.settings.pretitle != blank -%}
        <p class="hero-banner__pretitle">
          <span aria-hidden="true">✨</span>
          {{ section.settings.pretitle }}
        </p>
      {%- endif -%}

      <h1 class="hero-banner__title">
        {%- assign words = heading | split: '…' -%}
        {%- if words.size > 1 -%}
          {{ words[0] }}…<span>{{ words[1] }}</span>
        {%- else -%}
          {{ heading }}
        {%- endif -%}
      </h1>

      {%- if subheading != blank -%}
        <p class="hero-banner__subtitle">{{ subheading }}</p>
      {%- endif -%}

      <div class="hero-banner__actions">
        <a href="/collections/all" class="btn btn-primary btn-lg">تسوّقي الآن</a>
        <a href="/collections" class="btn btn-outline-hero btn-lg">تصفّحي الفئات</a>
      </div>

      {%- if show_delivery -%}
        <div class="hero-banner__badge">
          {%- render 'badge', badge_type: 'delivery', badge_text: delivery_text -%}
        </div>
      {%- endif -%}

      {%- if section.settings.image != blank -%}
        <div class="hero-banner__image">
          {{ section.settings.image | image_url: width: 680 | image_tag: loading: 'eager', alt: heading }}
        </div>
      {%- endif -%}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "البانر الرئيسي",
  "tag": "section",
  "class": "section-hero-banner",
  "limit": 1,
  "settings": [
    { "type": "header", "content": "المحتوى" },
    { "type": "text", "id": "pretitle", "label": "النص التمهيدي", "default": "متجر التنظيم المنزلي" },
    { "type": "text", "id": "heading", "label": "العنوان الرئيسي", "default": "بيتك مرتب… حياتك أسهل" },
    { "type": "textarea", "id": "subheading", "label": "النص الفرعي", "default": "اكتشفي أجمل حلول التنظيم المنزلي المصممة خصيصًا لكِ." },
    { "type": "header", "content": "الصورة" },
    { "type": "image_picker", "id": "image", "label": "صورة البانر" },
    { "type": "header", "content": "التصميم" },
    { "type": "color", "id": "bg_color", "label": "لون الخلفية" },
    { "type": "checkbox", "id": "show_delivery_badge", "label": "شارة التوصيل", "default": false }
  ],
  "presets": [{ "name": "البانر الرئيسي" }]
}
{% endschema %}