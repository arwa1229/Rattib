{%- liquid
  assign word_color = '#262B2B'
  assign bar3_color = '#262B2B'
  if inverted
    assign word_color = '#FFFFFF'
    assign bar3_color = '#FFFFFF'
  endif
-%}
<div style="display:inline-flex;flex-direction:column;align-items:center;gap:0;line-height:1;">
  <!-- 3 shelf bars -->
  <div style="display:flex;flex-direction:column;align-items:center;gap:3.5px;margin-bottom:6px;">
    <div style="width:14px;height:3.5px;border-radius:2px;background:#5BC4BE;"></div>
    <div style="width:26px;height:3.5px;border-radius:2px;background:#2E8F8A;"></div>
    <div style="width:40px;height:3.5px;border-radius:2px;background:{{ bar3_color }};"></div>
  </div>
  <!-- Arabic wordmark -->
  <span style="font-family:'Tajawal',sans-serif;font-weight:900;font-size:28px;color:{{ word_color }};line-height:1;direction:rtl;unicode-bidi:embed;">رتّب</span>
  <!-- Latin sub-mark -->
  <span style="font-family:'Tajawal',sans-serif;font-weight:500;font-size:8px;letter-spacing:5px;color:#A8B4B3;margin-top:3px;">RATTIB</span>
</div>
