{%- liquid
  assign word_color  = '#262B2B'
  assign bar3_color  = '#262B2B'
  assign sub_color   = '#A8B4B3'
  if inverted
    assign word_color = '#FFFFFF'
    assign bar3_color = '#FFFFFF'
  endif
-%}
<svg viewBox="0 0 160 80" xmlns="http://www.w3.org/2000/svg"
     width="120" height="60" role="img" aria-label="رتّب">
  <!-- Shelf bars: narrowest on top, widest on bottom, center-aligned -->
  <rect x="68"  y="4"  width="24" height="5" rx="2.5" fill="#5BC4BE"/>
  <rect x="58"  y="13" width="44" height="5" rx="2.5" fill="#2E8F8A"/>
  <rect x="46"  y="22" width="68" height="5" rx="2.5" fill="{{ bar3_color }}"/>
  <!-- Arabic wordmark رتّب using foreignObject for reliable rendering -->
  <foreignObject x="0" y="28" width="160" height="40">
    <div xmlns="http://www.w3.org/1999/xhtml"
         style="font-family:'Tajawal',sans-serif;font-weight:900;font-size:32px;color:{{ word_color }};text-align:center;line-height:1.1;direction:rtl;">
      رتّب
    </div>
  </foreignObject>
  <!-- Latin sub-mark -->
  <text x="80" y="76" text-anchor="middle"
        font-family="Arial,sans-serif" font-weight="600" font-size="8"
        letter-spacing="5" fill="{{ sub_color }}">RATTIB</text>
</svg>
