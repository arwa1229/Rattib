{%- liquid
  assign word_color = '#262B2B'
  assign bar3_color = '#262B2B'
  if inverted
    assign word_color = '#FFFFFF'
    assign bar3_color = '#FFFFFF'
  endif
-%}
<div class="rattib-logo-mark" aria-label="رتّب" role="img" style="display:inline-flex;flex-direction:column;align-items:center;gap:2px;text-decoration:none;">
  <!-- Shelf bars -->
  <div style="display:flex;flex-direction:column;align-items:center;gap:3px;margin-bottom:4px;">
    <div style="width:12px;height:3px;border-radius:2px;background:#5BC4BE;"></div>
    <div style="width:22px;height:3px;border-radius:2px;background:#2E8F8A;"></div>
    <div style="width:34px;height:3px;border-radius:2px;background:{{ bar3_color }};"></div>
  </div>
  <!-- Arabic wordmark -->
  <span style="font-family:'Tajawal',sans-serif;font-weight:900;font-size:26px;line-height:1;color:{{ word_color }};letter-spacing:-0.5px;">رتّب</span>
  <!-- Latin sub-mark -->
  <span style="font-family:'Tajawal',sans-serif;font-weight:500;font-size:9px;letter-spacing:4px;color:#A8B4B3;margin-top:1px;">RATTIB</span>
</div>
