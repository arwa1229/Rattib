<!DOCTYPE html>
<html dir="rtl" lang="ar" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#5BC4BE">

  <title>
    {%- if page_title == blank -%}
      {{ shop.name }} {{ settings.meta_title_suffix }}
    {%- else -%}
      {{ page_title }} {{ settings.meta_title_suffix }}
    {%- endif -%}
  </title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- else -%}
    <meta name="description" content="{{ settings.meta_description_default | escape }}">
  {%- endif -%}

  <!-- Open Graph -->
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:title" content="{{ page_title | default: shop.name }}">
  <meta property="og:type" content="website">
  {%- if page_description -%}
    <meta property="og:description" content="{{ page_description | escape }}">
  {%- endif -%}
  {%- if settings.share_image -%}
    <meta property="og:image" content="{{ settings.share_image | image_url: width: 1200 }}">
  {%- endif -%}

  <!-- Canonical -->
  <link rel="canonical" href="{{ canonical_url }}">

  <!-- Preconnect to Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <!-- Google Fonts: Tajawal + IBM Plex Sans Arabic -->
  <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@700;900&family=IBM+Plex+Sans+Arabic:wght@300;400;500&display=swap" rel="stylesheet">

  <!-- Theme CSS -->
  {{ 'rattib.css' | asset_url | stylesheet_tag }}

  <!-- Shopify Required -->
  {{ content_for_header }}

  <!-- Inline CSS Variables from Theme Settings -->
  <style>
    :root {
      --rattib-aqua:         {{ settings.color_primary }};
      --rattib-aqua-deep:    {{ settings.color_primary_deep }};
      --rattib-aqua-soft:    {{ settings.color_primary_soft }};
      --rattib-charcoal:     {{ settings.color_charcoal }};
      --rattib-gray:         {{ settings.color_gray }};
      --rattib-white:        {{ settings.color_white }};
      --rattib-success:      {{ settings.color_success }};
      --rattib-success-soft: {{ settings.color_success_soft }};
      --rattib-rating:       {{ settings.color_rating }};
      --color-text:          {{ settings.color_text_primary }};
      --color-text-secondary:{{ settings.color_text_secondary }};
      --color-price:         {{ settings.color_price }};
      --color-bg:            {{ settings.color_bg_body }};
      --color-bg-card:       {{ settings.color_bg_card }};
      --color-border:        {{ settings.color_border_card }};
      --font-heading:        {{ settings.font_heading }}, sans-serif;
      --font-body:           {{ settings.font_body }}, sans-serif;
      --font-size-base:      {{ settings.font_size_base }}px;
      --max-width:           {{ settings.max_width }}px;
      --spacing-section:     {{ settings.spacing_section }}px;
      --spacing-card-gap:    {{ settings.spacing_card_gap }}px;
      --radius-card:         {{ settings.radius_card }}px;
      --radius-btn:          {{ settings.radius_btn }}px;
    }
  </style>

  <!-- Analytics: Google Analytics 4 -->
  {%- if settings.google_analytics_id != blank -%}
    <script async src="https://www.googletagmanager.com/gtag/js?id={{ settings.google_analytics_id }}"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', '{{ settings.google_analytics_id }}');
    </script>
  {%- endif -%}

  <!-- Analytics: Meta Pixel -->
  {%- if settings.meta_pixel_id != blank -%}
    <script>
      !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
      n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
      document,'script','https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '{{ settings.meta_pixel_id }}');
      fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none"
      src="https://www.facebook.com/tr?id={{ settings.meta_pixel_id }}&ev=PageView&noscript=1"/></noscript>
  {%- endif -%}

  <!-- Analytics: TikTok Pixel -->
  {%- if settings.tiktok_pixel_id != blank -%}
    <script>
      !function(w,d,t){w.TiktokAnalyticsObject=t;var ttq=w[t]=w[t]||[];
      ttq.methods=["page","track","identify","instances","debug","on","off","once","ready","alias","group","enableCookie","disableCookie"];
      ttq.setAndDefer=function(t,e){t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}};
      for(var i=0;i<ttq.methods.length;i++)ttq.setAndDefer(ttq,ttq.methods[i]);
      ttq.instance=function(t){for(var e=ttq._i[t]||[],n=0;n<ttq.methods.length;n++)ttq.setAndDefer(e,ttq.methods[n]);return e};
      ttq.load=function(e,n){var i="https://analytics.tiktok.com/i18n/pixel/events.js";
      ttq._i=ttq._i||{};ttq._i[e]=[];ttq._i[e]._u=i;ttq._t=ttq._t||{};ttq._t[e]=+new Date;
      ttq._o=ttq._o||{};ttq._o[e]=n||{};var o=document.createElement("script");
      o.type="text/javascript";o.async=!0;o.src=i+"?sdkid="+e+"&lib="+t;
      var a=document.getElementsByTagName("script")[0];a.parentNode.insertBefore(o,a)};
      ttq.load('{{ settings.tiktok_pixel_id }}');ttq.page()}(window,document,'ttq');
    </script>
  {%- endif -%}
</head>

<body class="template-{{ template.name | handle }}{% if customer %} customer-logged-in{% endif %}">
  <a href="#main-content" class="visually-hidden">تخطي إلى المحتوى الرئيسي</a>

  <!-- ── Ribbon ─────────────────────────────────────────── -->
  <div class="free-shipping-bar">🚚 شحن مجاني على الطلبات فوق ١٩٩ ر.س</div>

  <!-- ── Site Header ─────────────────────────────────────── -->
  <header class="site-header{% if settings.header_sticky %} site-header--sticky{% endif %}" id="site-header" role="banner">

    <!-- Main Header Row -->
    <div class="site-header__inner">

      <!-- Logo -->
      <a href="{{ routes.root_url }}" class="site-header__logo" aria-label="{{ shop.name }} — الصفحة الرئيسية">
        {%- if settings.logo -%}
          {{
            settings.logo
            | image_url: width: settings.logo_width
            | image_tag:
                width: settings.logo_width,
                alt: shop.name,
                loading: 'eager',
                fetchpriority: 'high'
          }}
        {%- else -%}
          {%- render 'rattib-logo-svg', inverted: true -%}
        {%- endif -%}
      </a>

      <!-- Desktop Navigation -->
      <nav class="site-header__nav" aria-label="التنقل الرئيسي">
        {%- if linklists[settings.main_menu].links != blank -%}
          {%- for link in linklists[settings.main_menu].links -%}
            <a href="{{ link.url }}"
               class="site-header__nav-link{% if link.active %} active{% endif %}"
               {% if link.active %}aria-current="page"{% endif %}>
              {{ link.title }}
            </a>
          {%- endfor -%}
        {%- else -%}
          <a href="/collections/تنظيم-المطبخ"  class="site-header__nav-link">🍳 تنظيم المطبخ</a>
          <a href="/collections/تنظيم-الثلاجة"  class="site-header__nav-link">🧊 تنظيم الثلاجة</a>
          <a href="/collections/تنظيم-الحمام"   class="site-header__nav-link">🛁 تنظيم الحمام</a>
          <a href="/collections/الأدراج-والخزائن" class="site-header__nav-link">🗄️ الأدراج</a>
          <a href="/collections/غرفة-الغسيل"    class="site-header__nav-link">🧺 الغسيل</a>
          <a href="/collections/غرف-الأطفال"    class="site-header__nav-link">🧸 الأطفال</a>
        {%- endif -%}
      </nav>

      <!-- Actions -->
      <div class="site-header__actions" role="group" aria-label="إجراءات الحساب والسلة">

        <!-- Search -->
        {%- if settings.header_show_search -%}
          <a href="{{ routes.search_url }}" class="site-header__action-btn" aria-label="البحث">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"/>
            </svg>
          </a>
        {%- endif -%}

        <!-- Account -->
        {%- if settings.header_show_account -%}
          <a href="{{ routes.account_url }}" class="site-header__action-btn" aria-label="{%- if customer -%}حسابي{%- else -%}تسجيل الدخول{%- endif -%}">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"/>
            </svg>
          </a>
        {%- endif -%}

        <!-- Cart -->
        <a href="{{ routes.cart_url }}" class="site-header__action-btn" aria-label="السلة ({{ cart.item_count }} منتج)">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"/>
          </svg>
          <span class="site-header__cart-count" id="cart-count" data-count="{{ cart.item_count }}">
            {%- if cart.item_count > 0 -%}{{ cart.item_count }}{%- endif -%}
          </span>
        </a>

        <!-- Hamburger (mobile only) -->
        <button class="site-header__hamburger" id="hamburger-btn" aria-label="القائمة" aria-expanded="false" aria-controls="mobile-menu">
          <span></span><span></span><span></span>
        </button>

      </div><!-- /.site-header__actions -->
    </div><!-- /.site-header__inner -->
  </header>

  <!-- ── Mobile Menu Drawer ─────────────────────────────────── -->
  <div class="mobile-menu-overlay" id="mobile-menu-overlay" aria-hidden="true"></div>
  <nav class="mobile-menu" id="mobile-menu" aria-label="قائمة الموبايل" aria-hidden="true">
    <div class="mobile-menu__header">
      <span class="mobile-menu__title">القائمة</span>
      <button class="mobile-menu__close" id="mobile-menu-close" aria-label="إغلاق القائمة">✕</button>
    </div>
    <ul class="mobile-menu__links">
      {%- if linklists[settings.main_menu].links != blank -%}
        {%- for link in linklists[settings.main_menu].links -%}
          <li><a href="{{ link.url }}" class="mobile-menu__link{% if link.active %} active{% endif %}">{{ link.title }}</a></li>
        {%- endfor -%}
      {%- else -%}
        <li><a href="/collections/تنظيم-المطبخ"    class="mobile-menu__link">🍳 تنظيم المطبخ</a></li>
        <li><a href="/collections/تنظيم-الثلاجة"    class="mobile-menu__link">🧊 تنظيم الثلاجة</a></li>
        <li><a href="/collections/تنظيم-الحمام"     class="mobile-menu__link">🛁 تنظيم الحمام</a></li>
        <li><a href="/collections/الأدراج-والخزائن" class="mobile-menu__link">🗄️ الأدراج والخزائن</a></li>
        <li><a href="/collections/غرفة-الغسيل"      class="mobile-menu__link">🧺 غرفة الغسيل</a></li>
        <li><a href="/collections/غرف-الأطفال"      class="mobile-menu__link">🧸 غرف الأطفال</a></li>
      {%- endif -%}
      <li><a href="{{ routes.root_url }}"    class="mobile-menu__link">🏠 الرئيسية</a></li>
      <li><a href="/pages/about"             class="mobile-menu__link">من نحن</a></li>
      <li><a href="/pages/contact"           class="mobile-menu__link">تواصل معنا</a></li>
    </ul>
  </nav>

  <!-- ── Main Content ────────────────────────────────────── -->
  <main id="main-content" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  <!-- ── Site Footer ────────────────────────────────────── -->
  <footer class="site-footer" role="contentinfo">
    <div class="site-footer__inner">

      <!-- Top grid: Brand | Quick Links | Categories -->
      <div class="site-footer__grid">

        <!-- Col 1: Brand -->
        <div class="site-footer__col site-footer__col--brand">
          <a href="{{ routes.root_url }}" class="site-footer__logo-link" aria-label="{{ shop.name }}">
            {%- render 'rattib-logo-svg', inverted: true -%}
          </a>
          <p class="site-footer__tagline">بيتك مرتب… حياتك أسهل</p>
          <p class="site-footer__desc">متجر متخصص في منتجات التنظيم المنزلي للسوق السعودي والخليجي.</p>
          <!-- Social icons -->
          <div class="site-footer__social">
            {%- if settings.social_tiktok != blank -%}
              <a href="{{ settings.social_tiktok }}" class="footer-social-btn" target="_blank" rel="noopener" aria-label="تيك توك">
                <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.32 6.32 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.76a4.85 4.85 0 0 1-1.01-.07z"/></svg>
              </a>
            {%- endif -%}
            {%- if settings.social_instagram != blank -%}
              <a href="{{ settings.social_instagram }}" class="footer-social-btn" target="_blank" rel="noopener" aria-label="إنستغرام">
                <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
              </a>
            {%- endif -%}
            {%- if settings.social_snapchat != blank -%}
              <a href="{{ settings.social_snapchat }}" class="footer-social-btn" target="_blank" rel="noopener" aria-label="سناب شات">
                <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M12.206.793c.99 0 4.347.276 5.93 3.821.529 1.193.403 3.219.299 4.847l-.003.06c-.012.18-.022.345-.03.51.075.045.203.09.401.09.3-.016.659-.12 1.033-.301.165-.088.344-.104.464-.104.182 0 .359.029.509.09.45.149.734.479.734.838.015.449-.39.839-1.213 1.168-.089.029-.209.075-.344.119-.45.135-1.139.36-1.333.81-.09.224-.061.524.12.868l.015.015c.06.136 1.526 3.475 4.791 4.014.255.044.435.27.42.509 0 .075-.015.149-.045.225-.24.569-1.273.988-3.146 1.271-.059.091-.12.375-.164.57-.029.179-.074.36-.134.553-.076.271-.27.405-.555.405h-.03c-.135 0-.313-.031-.538-.074-.36-.075-.765-.135-1.273-.135-.3 0-.599.015-.913.074-.6.104-1.123.464-1.723.884-.853.599-1.826 1.288-3.294 1.288-.06 0-.119-.015-.18-.015h-.149c-1.468 0-2.427-.675-3.279-1.288-.599-.42-1.107-.779-1.707-.884-.314-.045-.629-.074-.928-.074-.54 0-.958.089-1.272.149-.211.043-.391.074-.54.074-.374 0-.523-.224-.583-.42-.061-.192-.09-.389-.135-.567-.046-.181-.105-.494-.166-.57-1.918-.222-2.95-.642-3.189-1.226-.031-.063-.052-.15-.055-.225-.015-.243.165-.465.42-.509 3.264-.54 4.73-3.879 4.791-4.02l.016-.029c.18-.345.224-.645.119-.869-.195-.434-.884-.658-1.332-.809-.121-.029-.24-.074-.346-.119-1.107-.435-1.257-.93-1.197-1.273.09-.479.674-.793 1.168-.793.146 0 .27.029.383.074.42.194.789.3 1.104.3.234 0 .384-.06.465-.105l-.046-.569c-.098-1.626-.225-3.651.295-4.836C7.85 1.07 11.206.793 12.206.793z"/></svg>
              </a>
            {%- endif -%}
            {%- if settings.social_twitter != blank -%}
              <a href="{{ settings.social_twitter }}" class="footer-social-btn" target="_blank" rel="noopener" aria-label="تويتر / X">
                <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
            {%- endif -%}
          </div>
        </div>

        <!-- Col 2: Quick Links -->
        <div class="site-footer__col">
          <p class="site-footer__col-title">روابط سريعة</p>
          <ul class="site-footer__links">
            <li><a href="{{ routes.root_url }}" class="site-footer__link">الرئيسية</a></li>
            <li><a href="{{ routes.search_url }}" class="site-footer__link">البحث</a></li>
            <li><a href="/pages/about" class="site-footer__link">من نحن</a></li>
            <li><a href="/pages/contact" class="site-footer__link">تواصل معنا</a></li>
          </ul>
        </div>

        <!-- Col 3: Policies -->
        <div class="site-footer__col">
          <p class="site-footer__col-title">المساعدة</p>
          <ul class="site-footer__links">
            <li><a href="/pages/shipping-policy" class="site-footer__link">سياسة الشحن</a></li>
            <li><a href="/pages/refund-policy" class="site-footer__link">سياسة الإرجاع</a></li>
            <li><a href="/pages/privacy-policy" class="site-footer__link">سياسة الخصوصية</a></li>
            <li><a href="/pages/faq" class="site-footer__link">الأسئلة الشائعة</a></li>
          </ul>
        </div>

      </div><!-- /.site-footer__grid -->

      <!-- Divider -->
      <hr class="site-footer__divider">

      <!-- Bottom: copyright + payment -->
      <div class="site-footer__bottom">

        <!-- Payment methods -->
        <div class="site-footer__payment">
          <p class="site-footer__payment-label">وسائل الدفع المقبولة</p>
          <div class="payment-methods-row">
            <span class="payment-badge payment-badge--text">مدى</span>
            <span class="payment-badge payment-badge--text">Apple Pay</span>
            <span class="payment-badge payment-badge--text" style="color:#7B2FBE;">STC Pay</span>
            <span class="payment-badge payment-badge--text" style="color:#3DBFA0;">تابي</span>
            <span class="payment-badge payment-badge--text" style="color:#5BC4BE;">تمارا</span>
            <span class="payment-badge payment-badge--mc">
              <span style="display:inline-block;width:14px;height:14px;border-radius:50%;background:#EB001B;margin-inline-end:-5px;"></span>
              <span style="display:inline-block;width:14px;height:14px;border-radius:50%;background:#F79E1B;opacity:0.95;"></span>
            </span>
            <span class="payment-badge payment-badge--visa">VISA</span>
          </div>
        </div>

        <p class="site-footer__copyright">جميع الحقوق محفوظة @ رتّب {{ 'now' | date: '%Y' }}</p>

      </div><!-- /.site-footer__bottom -->

    </div><!-- /.site-footer__inner -->
  </footer>

  <!-- ── Mobile Bottom Navigation Bar ──────────────────── -->
  <nav class="mobile-nav" aria-label="التنقل السريع">
    <a href="{{ routes.root_url }}"
       class="mobile-nav__item{% if template.name == 'index' %} active{% endif %}"
       aria-label="الرئيسية"
       {% if template.name == 'index' %}aria-current="page"{% endif %}>
      <span class="mobile-nav__icon" aria-hidden="true">🏠</span>
      <span class="mobile-nav__label">الرئيسية</span>
    </a>

    <a href="{{ routes.search_url }}"
       class="mobile-nav__item{% if template.name == 'search' %} active{% endif %}"
       aria-label="البحث"
       {% if template.name == 'search' %}aria-current="page"{% endif %}>
      <span class="mobile-nav__icon" aria-hidden="true">🔍</span>
      <span class="mobile-nav__label">البحث</span>
    </a>

    <a href="{{ routes.cart_url }}"
       class="mobile-nav__item{% if template.name == 'cart' %} active{% endif %}"
       aria-label="السلة ({{ cart.item_count }} منتج)"
       {% if template.name == 'cart' %}aria-current="page"{% endif %}>
      <span class="mobile-nav__icon" aria-hidden="true">🛒</span>
      <span class="mobile-nav__label">السلة</span>
      {%- if cart.item_count > 0 -%}
        <span class="mobile-nav__cart-badge" aria-hidden="true" data-count="{{ cart.item_count }}">{{ cart.item_count }}</span>
      {%- endif -%}
    </a>

    <a href="{{ routes.account_url }}"
       class="mobile-nav__item{% if template.name == 'customers/account' or template.name == 'customers/login' %} active{% endif %}"
       aria-label="{%- if customer -%}حسابي{%- else -%}تسجيل الدخول{%- endif -%}">
      <span class="mobile-nav__icon" aria-hidden="true">👤</span>
      <span class="mobile-nav__label">{%- if customer -%}حسابي{%- else -%}دخول{%- endif -%}</span>
    </a>
  </nav>

  <!-- ── Scroll-to-top & Header Scroll Script ───────────── -->
  <script>
    (function () {
      'use strict';

      // Mark <html> as JS-enabled
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');

      // Sticky header shadow on scroll
      var header = document.getElementById('site-header');
      if (header) {
        window.addEventListener('scroll', function () {
          if (window.scrollY > 10) {
            header.classList.add('site-header--scrolled');
          } else {
            header.classList.remove('site-header--scrolled');
          }
        }, { passive: true });
      }

      // Mobile menu drawer
      var hamburger = document.getElementById('hamburger-btn');
      var mobileMenu = document.getElementById('mobile-menu');
      var overlay = document.getElementById('mobile-menu-overlay');
      var closeBtn = document.getElementById('mobile-menu-close');
      function openMenu() {
        mobileMenu.classList.add('open');
        overlay.classList.add('open');
        mobileMenu.setAttribute('aria-hidden', 'false');
        hamburger.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      }
      function closeMenu() {
        mobileMenu.classList.remove('open');
        overlay.classList.remove('open');
        mobileMenu.setAttribute('aria-hidden', 'true');
        hamburger.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }
      if (hamburger) hamburger.addEventListener('click', openMenu);
      if (closeBtn) closeBtn.addEventListener('click', closeMenu);
      if (overlay) overlay.addEventListener('click', closeMenu);

      // Cart count live update helper (used by AJAX cart sections)
      document.addEventListener('cart:updated', function (e) {
        var count = e.detail && e.detail.itemCount !== undefined ? e.detail.itemCount : 0;
        var countEls = document.querySelectorAll('[data-count]');
        countEls.forEach(function (el) {
          el.setAttribute('data-count', count);
          el.textContent = count > 0 ? count : '';
        });
      });
    })();
  </script>

</body>
</html>
