<!DOCTYPE html>
<html dir="rtl" lang="ar" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#5BC4BE">

  <title>
    {%- if page_title == blank -%}
      {{ shop.name }} {{ settings.meta_title_suffix }}
    {%- else -%}
      {{ page_title }} {{ settings.meta_title_suffix }}
    {%- endif -%}
  </title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- else -%}
    <meta name="description" content="{{ settings.meta_description_default | escape }}">
  {%- endif -%}

  <!-- Open Graph -->
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:title" content="{{ page_title | default: shop.name }}">
  <meta property="og:type" content="website">
  {%- if page_description -%}
    <meta property="og:description" content="{{ page_description | escape }}">
  {%- endif -%}
  {%- if settings.share_image -%}
    <meta property="og:image" content="{{ settings.share_image | image_url: width: 1200 }}">
  {%- endif -%}

  <!-- Canonical -->
  <link rel="canonical" href="{{ canonical_url }}">

  <!-- Preconnect to Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <!-- Google Fonts: Tajawal + IBM Plex Sans Arabic -->
  <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@700;900&family=IBM+Plex+Sans+Arabic:wght@300;400;500&display=swap" rel="stylesheet">

  <!-- Theme CSS -->
  {{ 'rattib.css' | asset_url | stylesheet_tag }}

  <!-- Shopify Required -->
  {{ content_for_header }}

  <!-- Inline CSS Variables from Theme Settings -->
  <style>
    :root {
      --rattib-aqua:         {{ settings.color_primary }};
      --rattib-aqua-deep:    {{ settings.color_primary_deep }};
      --rattib-aqua-soft:    {{ settings.color_primary_soft }};
      --rattib-charcoal:     {{ settings.color_charcoal }};
      --rattib-gray:         {{ settings.color_gray }};
      --rattib-white:        {{ settings.color_white }};
      --rattib-success:      {{ settings.color_success }};
      --rattib-success-soft: {{ settings.color_success_soft }};
      --rattib-rating:       {{ settings.color_rating }};
      --color-text:          {{ settings.color_text_primary }};
      --color-text-secondary:{{ settings.color_text_secondary }};
      --color-price:         {{ settings.color_price }};
      --color-bg:            {{ settings.color_bg_body }};
      --color-bg-card:       {{ settings.color_bg_card }};
      --color-border:        {{ settings.color_border_card }};
      --font-heading:        {{ settings.font_heading }}, sans-serif;
      --font-body:           {{ settings.font_body }}, sans-serif;
      --font-size-base:      {{ settings.font_size_base }}px;
      --max-width:           {{ settings.max_width }}px;
      --spacing-section:     {{ settings.spacing_section }}px;
      --spacing-card-gap:    {{ settings.spacing_card_gap }}px;
      --radius-card:         {{ settings.radius_card }}px;
      --radius-btn:          {{ settings.radius_btn }}px;
    }
  </style>

  <!-- Analytics: Google Analytics 4 -->
  {%- if settings.google_analytics_id != blank -%}
    <script async src="https://www.googletagmanager.com/gtag/js?id={{ settings.google_analytics_id }}"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', '{{ settings.google_analytics_id }}');
    </script>
  {%- endif -%}

  <!-- Analytics: Meta Pixel -->
  {%- if settings.meta_pixel_id != blank -%}
    <script>
      !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
      n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
      document,'script','https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '{{ settings.meta_pixel_id }}');
      fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none"
      src="https://www.facebook.com/tr?id={{ settings.meta_pixel_id }}&ev=PageView&noscript=1"/></noscript>
  {%- endif -%}

  <!-- Analytics: TikTok Pixel -->
  {%- if settings.tiktok_pixel_id != blank -%}
    <script>
      !function(w,d,t){w.TiktokAnalyticsObject=t;var ttq=w[t]=w[t]||[];
      ttq.methods=["page","track","identify","instances","debug","on","off","once","ready","alias","group","enableCookie","disableCookie"];
      ttq.setAndDefer=function(t,e){t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}};
      for(var i=0;i<ttq.methods.length;i++)ttq.setAndDefer(ttq,ttq.methods[i]);
      ttq.instance=function(t){for(var e=ttq._i[t]||[],n=0;n<ttq.methods.length;n++)ttq.setAndDefer(e,ttq.methods[n]);return e};
      ttq.load=function(e,n){var i="https://analytics.tiktok.com/i18n/pixel/events.js";
      ttq._i=ttq._i||{};ttq._i[e]=[];ttq._i[e]._u=i;ttq._t=ttq._t||{};ttq._t[e]=+new Date;
      ttq._o=ttq._o||{};ttq._o[e]=n||{};var o=document.createElement("script");
      o.type="text/javascript";o.async=!0;o.src=i+"?sdkid="+e+"&lib="+t;
      var a=document.getElementsByTagName("script")[0];a.parentNode.insertBefore(o,a)};
      ttq.load('{{ settings.tiktok_pixel_id }}');ttq.page()}(window,document,'ttq');
    </script>
  {%- endif -%}
</head>

<body class="template-{{ template.name | handle }}{% if customer %} customer-logged-in{% endif %}">
  <a href="#main-content" class="visually-hidden">تخطي إلى المحتوى الرئيسي</a>

  <!-- ── Site Header ─────────────────────────────────────── -->
  <header class="site-header{% if settings.header_sticky %} site-header--sticky{% endif %}" id="site-header" role="banner">

    <!-- Free Shipping Bar -->
    {%- if settings.show_free_shipping_bar -%}
      <div class="site-header__free-shipping" aria-label="عرض الشحن المجاني">
        {{ settings.free_shipping_bar_text }}
      </div>
    {%- endif -%}

    <!-- Main Header Row -->
    <div class="site-header__main">

      <!-- Logo -->
      <a href="{{ routes.root_url }}" class="site-header__logo" aria-label="{{ shop.name }} — الصفحة الرئيسية">
        {%- if settings.logo -%}
          {{
            settings.logo
            | image_url: width: settings.logo_width
            | image_tag:
                width: settings.logo_width,
                alt: shop.name,
                loading: 'eager',
                fetchpriority: 'high'
          }}
        {%- else -%}
          {%- render 'rattib-logo-svg' -%}
        {%- endif -%}
      </a>

      <!-- Desktop Navigation -->
      <nav class="site-header__nav" aria-label="التنقل الرئيسي">
        {%- if linklists[settings.main_menu].links != blank -%}
          {%- for link in linklists[settings.main_menu].links -%}
            <a href="{{ link.url }}"
               class="site-header__nav-link{% if link.active %} active{% endif %}"
               {% if link.active %}aria-current="page"{% endif %}>
              {{ link.title }}
            </a>
          {%- endfor -%}
        {%- else -%}
          <a href="/collections/تنظيم-المطبخ"  class="site-header__nav-link">🍳 تنظيم المطبخ</a>
          <a href="/collections/تنظيم-الثلاجة"  class="site-header__nav-link">🧊 تنظيم الثلاجة</a>
          <a href="/collections/تنظيم-الحمام"   class="site-header__nav-link">🛁 تنظيم الحمام</a>
          <a href="/collections/الأدراج-والخزائن" class="site-header__nav-link">🗄️ الأدراج</a>
          <a href="/collections/غرفة-الغسيل"    class="site-header__nav-link">🧺 الغسيل</a>
          <a href="/collections/غرف-الأطفال"    class="site-header__nav-link">🧸 الأطفال</a>
        {%- endif -%}
      </nav>

      <!-- Actions -->
      <div class="site-header__actions" role="group" aria-label="إجراءات الحساب والسلة">

        <!-- Search -->
        {%- if settings.header_show_search -%}
          <a href="{{ routes.search_url }}" class="site-header__action-btn" aria-label="البحث">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"/>
            </svg>
          </a>
        {%- endif -%}

        <!-- Account -->
        {%- if settings.header_show_account -%}
          <a href="{{ routes.account_url }}" class="site-header__action-btn" aria-label="{%- if customer -%}حسابي{%- else -%}تسجيل الدخول{%- endif -%}">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"/>
            </svg>
          </a>
        {%- endif -%}

        <!-- Cart -->
        <a href="{{ routes.cart_url }}" class="site-header__action-btn" aria-label="السلة ({{ cart.item_count }} منتج)">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"/>
          </svg>
          <span class="site-header__cart-count" id="cart-count" data-count="{{ cart.item_count }}">
            {%- if cart.item_count > 0 -%}{{ cart.item_count }}{%- endif -%}
          </span>
        </a>

      </div><!-- /.site-header__actions -->
    </div><!-- /.site-header__main -->
  </header>

  <!-- ── Main Content ────────────────────────────────────── -->
  <main id="main-content" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  <!-- ── Site Footer ────────────────────────────────────── -->
  <footer class="site-footer" role="contentinfo" aria-label="تذييل الصفحة">
    <div class="site-footer__inner">
      <div class="site-footer__top">

        <!-- Brand Column -->
        <div class="site-footer__brand">
          <a href="{{ routes.root_url }}" class="site-footer__logo" aria-label="{{ shop.name }}">
            {%- render 'rattib-logo-svg', inverted: true -%}
          </a>
          {%- if settings.footer_tagline != blank -%}
            <p class="site-footer__tagline">{{ settings.footer_tagline }}</p>
          {%- endif -%}
          {%- if settings.footer_about != blank -%}
            <div class="site-footer__about">{{ settings.footer_about }}</div>
          {%- endif -%}

          <!-- Social Links -->
          <div class="site-footer__social" aria-label="وسائل التواصل الاجتماعي">
            {%- if settings.social_instagram != blank -%}
              <a href="{{ settings.social_instagram }}" class="site-footer__social-link" target="_blank" rel="noopener" aria-label="إنستغرام">
                📷
              </a>
            {%- endif -%}
            {%- if settings.social_tiktok != blank -%}
              <a href="{{ settings.social_tiktok }}" class="site-footer__social-link" target="_blank" rel="noopener" aria-label="تيك توك">
                🎵
              </a>
            {%- endif -%}
            {%- if settings.social_twitter != blank -%}
              <a href="{{ settings.social_twitter }}" class="site-footer__social-link" target="_blank" rel="noopener" aria-label="تويتر">
                𝕏
              </a>
            {%- endif -%}
            {%- if settings.social_snapchat != blank -%}
              <a href="{{ settings.social_snapchat }}" class="site-footer__social-link" target="_blank" rel="noopener" aria-label="سناب شات">
                👻
              </a>
            {%- endif -%}
          </div>
        </div>

        <!-- Links Column -->
        {%- if linklists[settings.footer_menu].links != blank -%}
          <div class="site-footer__links-col">
            <p class="site-footer__links-title">روابط سريعة</p>
            <ul class="site-footer__links" role="list">
              {%- for link in linklists[settings.footer_menu].links -%}
                <li>
                  <a href="{{ link.url }}" class="site-footer__link">{{ link.title }}</a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- else -%}
          <div class="site-footer__links-col">
            <p class="site-footer__links-title">روابط سريعة</p>
            <ul class="site-footer__links" role="list">
              <li><a href="{{ routes.root_url }}"           class="site-footer__link">الرئيسية</a></li>
              <li><a href="{{ routes.all_products_collection_url }}" class="site-footer__link">جميع المنتجات</a></li>
              <li><a href="{{ routes.search_url }}"         class="site-footer__link">البحث</a></li>
              <li><a href="/pages/about"                    class="site-footer__link">من نحن</a></li>
              <li><a href="/pages/shipping-policy"          class="site-footer__link">سياسة الشحن</a></li>
              <li><a href="/pages/refund-policy"            class="site-footer__link">سياسة الإرجاع</a></li>
              <li><a href="/pages/contact"                  class="site-footer__link">تواصلي معنا</a></li>
            </ul>
          </div>
        {%- endif -%}

      </div><!-- /.site-footer__top -->

      <hr class="site-footer__divider">

      <!-- Footer Bottom -->
      <div class="site-footer__bottom">
        <p class="site-footer__copyright">{{ settings.footer_copyright }}</p>

        <div class="site-footer__payment" aria-label="طرق الدفع المقبولة">
          <p class="site-footer__payment-label">وسائل الدفع المقبولة</p>
          <div class="payment-methods-row">
            <span class="payment-badge">
              <svg viewBox="0 0 38 24" width="38" height="24" aria-hidden="true"><rect width="38" height="24" rx="4" fill="#1A1F71"/><text x="5" y="17" font-family="Arial,sans-serif" font-size="10" font-weight="bold" fill="#fff">VISA</text></svg>
            </span>
            <span class="payment-badge">
              <svg viewBox="0 0 38 24" width="38" height="24" aria-hidden="true"><rect width="38" height="24" rx="4" fill="#EB001B"/><circle cx="15" cy="12" r="7" fill="#EB001B"/><circle cx="23" cy="12" r="7" fill="#F79E1B"/><path d="M19 6.8a7 7 0 0 1 0 10.4A7 7 0 0 1 19 6.8z" fill="#FF5F00"/></svg>
            </span>
            <span class="payment-badge" style="font-size:11px;font-weight:700;font-family:'Tajawal',sans-serif;color:#fff;padding:5px 10px;">مدى</span>
            <span class="payment-badge" style="font-size:11px;font-weight:700;font-family:'Tajawal',sans-serif;color:#fff;padding:5px 10px;">Apple Pay</span>
            <span class="payment-badge" style="font-size:11px;font-weight:700;font-family:'Tajawal',sans-serif;color:#fff;padding:5px 10px;">STC Pay</span>
            <span class="payment-badge" style="font-size:11px;font-weight:700;font-family:'Tajawal',sans-serif;color:#5BC4BE;padding:5px 10px;">تابي</span>
            <span class="payment-badge" style="font-size:11px;font-weight:700;font-family:'Tajawal',sans-serif;color:#5BC4BE;padding:5px 10px;">تمارا</span>
          </div>
        </div>
      </div>
    </div><!-- /.site-footer__inner -->
  </footer>

  <!-- ── Mobile Bottom Navigation Bar ──────────────────── -->
  <nav class="mobile-nav" aria-label="التنقل السريع">
    <a href="{{ routes.root_url }}"
       class="mobile-nav__item{% if template.name == 'index' %} active{% endif %}"
       aria-label="الرئيسية"
       {% if template.name == 'index' %}aria-current="page"{% endif %}>
      <span class="mobile-nav__icon" aria-hidden="true">🏠</span>
      <span class="mobile-nav__label">الرئيسية</span>
    </a>

    <a href="{{ routes.search_url }}"
       class="mobile-nav__item{% if template.name == 'search' %} active{% endif %}"
       aria-label="البحث"
       {% if template.name == 'search' %}aria-current="page"{% endif %}>
      <span class="mobile-nav__icon" aria-hidden="true">🔍</span>
      <span class="mobile-nav__label">البحث</span>
    </a>

    <a href="{{ routes.cart_url }}"
       class="mobile-nav__item{% if template.name == 'cart' %} active{% endif %}"
       aria-label="السلة ({{ cart.item_count }} منتج)"
       {% if template.name == 'cart' %}aria-current="page"{% endif %}>
      <span class="mobile-nav__icon" aria-hidden="true">🛒</span>
      <span class="mobile-nav__label">السلة</span>
      {%- if cart.item_count > 0 -%}
        <span class="mobile-nav__cart-badge" aria-hidden="true" data-count="{{ cart.item_count }}">{{ cart.item_count }}</span>
      {%- endif -%}
    </a>

    <a href="{{ routes.account_url }}"
       class="mobile-nav__item{% if template.name == 'customers/account' or template.name == 'customers/login' %} active{% endif %}"
       aria-label="{%- if customer -%}حسابي{%- else -%}تسجيل الدخول{%- endif -%}">
      <span class="mobile-nav__icon" aria-hidden="true">👤</span>
      <span class="mobile-nav__label">{%- if customer -%}حسابي{%- else -%}دخول{%- endif -%}</span>
    </a>
  </nav>

  <!-- ── Scroll-to-top & Header Scroll Script ───────────── -->
  <script>
    (function () {
      'use strict';

      // Mark <html> as JS-enabled
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');

      // Sticky header shadow on scroll
      var header = document.getElementById('site-header');
      if (header) {
        window.addEventListener('scroll', function () {
          if (window.scrollY > 10) {
            header.classList.add('site-header--scrolled');
          } else {
            header.classList.remove('site-header--scrolled');
          }
        }, { passive: true });
      }

      // Cart count live update helper (used by AJAX cart sections)
      document.addEventListener('cart:updated', function (e) {
        var count = e.detail && e.detail.itemCount !== undefined ? e.detail.itemCount : 0;
        var countEls = document.querySelectorAll('[data-count]');
        countEls.forEach(function (el) {
          el.setAttribute('data-count', count);
          el.textContent = count > 0 ? count : '';
        });
      });
    })();
  </script>

</body>
</html>
