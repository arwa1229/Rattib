# CJ Dropshipping API credentials
# Get from: https://developers.cjdropshipping.com/ → My Account → API
CJ_EMAIL=your-cj-account-email@example.com
CJ_API_KEY=your-cj-api-key-here

# Shopify credentials
# Get from: Shopify Admin → Settings → Apps and sales channels → Develop apps
# Required scopes: write_products, read_products
SHOPIFY_SHOP=rattib-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_your_access_token_here

# Optional overrides
# MARKUP=2.5
# USD_TO_SAR=3.75
# MAX_SHIPPING_USD=8
